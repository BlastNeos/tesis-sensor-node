  "title": "Datos Ambientales",
  "description": "Visualización temporal de las mediciones meteorológicas del nodo lit-cordoba-01.",
  "tags": [
    "tesis",
    "meteorologia"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 2,
  "refresh": "5m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
